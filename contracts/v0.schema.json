          ]
        }
      },
      "required": [
        "status",
        "model_version",
        "intelligence_index",
        "checked_at",
        "reason"
      ],
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "properties": {
        "version": {
          "const": "v0"
        },
        "batch_id": {
          "$ref": "#/$defs/id"
        },
        "provider_profile": {
          "$ref": "#/$defs/profile"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task_report"
          },
          "maxItems": 5,
          "minItems": 5
        },
        "evaluated": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "wrong_answers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "technical_skips": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "success": {
          "type": "boolean"
        },
        "course_model_status": {
          "$ref": "#/$defs/course_model_status"
        }
      },
      "required": [
        "version",
        "batch_id",
        "provider_profile",
        "started_at",
        "finished_at",
        "tasks",
        "evaluated",
        "wrong_answers",
        "technical_skips",
        "success",
        "course_model_status"
      ],
