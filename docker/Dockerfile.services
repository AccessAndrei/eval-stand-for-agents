# syntax=docker/dockerfile:1.7
# codex-source предоставляет бинарник и метаданные проверенной сборки из исходников.
FROM ghcr.io/astral-sh/uv:0.12.1 AS uv
FROM docker:29.9.2-cli AS docker-cli
FROM python:3.13.2-slim-bookworm AS python-base
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 libcap2 libasound2 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

FROM python-base AS dependencies
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock .python-version ./
ENV UV_PYTHON_DOWNLOADS=never UV_PROJECT_ENVIRONMENT=/opt/venv UV_NO_CACHE=1 UV_LINK_MODE=copy
RUN uv sync --frozen --no-dev --no-install-project --python /usr/local/bin/python3

FROM python-base AS runtime
ARG SERVICE_UID=1000
ARG SERVICE_GID=1000
WORKDIR /app
COPY --from=dependencies /opt/venv /opt/venv
COPY services /app/services
COPY contracts /app/contracts
COPY config /app/config
COPY scripts/healthcheck.py /app/scripts/healthcheck.py
ENV PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin PYTHONPATH=/app
RUN mkdir -p /state && chown ${SERVICE_UID}:${SERVICE_GID} /state
USER ${SERVICE_UID}:${SERVICE_GID}

FROM runtime AS gateway
CMD ["python", "-m", "services.gateway.server"]

FROM runtime AS proxy
CMD ["python", "-m", "services.llm_proxy"]

FROM runtime AS mock-provider
CMD ["python", "-m", "services.llm_proxy.mock", "--host", "0.0.0.0", "--port", "8090"]

FROM runtime AS workspace-broker
USER 0:0
RUN chown 0:0 /state
CMD ["python", "-m", "services.workspace_broker.server"]

FROM runtime AS runner
COPY baf/__init__.py /app/baf/__init__.py
COPY baf/runner /app/baf/runner
ENTRYPOINT ["python", "-m", "baf.runner", "--protocol", "v0"]

FROM runtime AS harness
COPY --from=codex-source /usr/local/bin/codex /usr/local/bin/codex
COPY --from=codex-source /usr/local/share/codex-build /usr/local/share/codex-build
CMD ["python", "-m", "services.harness.server"]

# Отдельная корневая ФС управляемого Docker-плагина.
FROM python:3.13.2-slim-bookworm@sha256:6b3223eb4d93718828223966ad316909c39813dee3ee9395204940500792b740 AS workspace-driver
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        fuse3=3.14.0-4 \
        openssh-client=1:9.2p1-2+deb12u10 \
        socat=1.7.4.4-2 \
        sshfs=3.7.3-1.2~deb12u1 \
        tini=0.19.0-1+b3 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /ipc /mnt/volumes /run
COPY --chmod=0644 services/workspace_driver/volume_driver.py /volume_driver.py

FROM runtime AS manager
USER 0:0
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --link --from=workspace-driver / /opt/eval-stand-workspace-driver/rootfs/
COPY --chmod=0644 services/workspace_driver/config.json /opt/eval-stand-workspace-driver/config.json
RUN chown 0:0 /state
CMD ["python", "-m", "services.sandbox_manager.server"]

# В среду агента не копируются сервисы, чекеры, конфигурация или credentials.
FROM python-base AS sandbox
COPY --from=codex-source /usr/local/bin/codex /usr/local/bin/codex
COPY --from=codex-source /usr/local/share/codex-build /usr/local/share/codex-build
USER 1000:1000
CMD ["/usr/local/bin/codex", "--version"]
