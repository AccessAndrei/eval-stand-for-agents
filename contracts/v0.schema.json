    "course_model_status": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "confirmed",
            "unconfirmed"
          ]
        },
        "model_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
