# Скопируйте в .env. Каждое значение *_TOKEN — отдельная случайная строка
# длиной не менее 24 символов. Пустые значения блокируют запуск сервисов.
CLIENT_TOKEN=
MANAGER_TOKEN=
HARNESS_TOKEN=
PROXY_TOKEN=

COMPOSE_PROJECT_NAME=eval-stand
PROJECT_ID=eval-stand
# На x86_64 Linux явно укажите linux/amd64 и соберите Codex для этой же платформы.
DOCKER_PLATFORM=linux/arm64
GATEWAY_PORT=8080
DOCKER_SOCKET=/var/run/docker.sock

# Файл появляется только после успешной измеренной source-build.
# Ровно поля contracts.provenance: codex_version, commit, origin,
# image_digest, architecture. Полный отчёт сборки хранится отдельно.
PROVENANCE_PATH=./results/source-build/provenance.runtime.json

# Прикладной предел истории gateway; результаты не удаляются автоматически.
# Это не дисковая квота Docker Desktop. Согласованный диск Docker — 32 ГБ.
STATE_LIMIT_BYTES=1000000000
RUNNER_STORAGE_BYTES=1000000000

# Каталог создайте заранее; LOCAL_UID/LOCAL_GID — вывод id -u / id -g.
# Раннер запускается однократно в Docker, с доступом только к этому каталогу.
RESULTS_PATH=./results
LOCAL_UID=1000
LOCAL_GID=1000

# Настраиваемая модель: base URL API без /responses, точный model id и API-ключ.
# Эти переменные передаются только llm-proxy через docker/compose.live.yml.
# Значение ключа не включается в профиль, результаты, harness или sandbox.
MODEL_ENDPOINT=
MODEL_ID=
MODEL_API_KEY=
# Live: make up; make checkpoint1 PROFILE=api
# Offline: docker compose -f docker-compose.yml -f docker/compose.mock.yml up --build
