# syntax=docker/dockerfile:1.7
# codex-source — локальные бинарник и метаданные, выгруженные из проверенной source-build.
FROM ghcr.io/astral-sh/uv:0.12.1 AS uv
FROM docker:29.9.2-cli AS docker-cli
FROM python:3.13.2-slim-bookworm AS python-base
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 libcap2 libasound2 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

FROM python-base AS dependencies
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock .python-version ./
ENV UV_PYTHON_DOWNLOADS=never UV_PROJECT_ENVIRONMENT=/opt/venv UV_NO_CACHE=1 UV_LINK_MODE=copy
RUN uv sync --frozen --no-dev --no-install-project --python /usr/local/bin/python3

FROM python-base AS runtime
ARG SERVICE_UID=1000
ARG SERVICE_GID=1000
WORKDIR /app
COPY --from=dependencies /opt/venv /opt/venv
COPY services /app/services
COPY contracts /app/contracts
COPY config /app/config
COPY scripts/healthcheck.py /app/scripts/healthcheck.py
ENV PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin PYTHONPATH=/app
RUN mkdir -p /state && chown ${SERVICE_UID}:${SERVICE_GID} /state
USER ${SERVICE_UID}:${SERVICE_GID}

FROM runtime AS gateway
CMD ["python", "-m", "services.gateway.server"]

FROM runtime AS proxy
CMD ["python", "-m", "services.llm_proxy"]

FROM runtime AS mock-provider
CMD ["python", "-m", "services.llm_proxy.mock", "--host", "0.0.0.0", "--port", "8090"]

FROM runtime AS runner
COPY baf /app/baf
ENTRYPOINT ["python", "-m", "baf.runner"]
CMD ["--profile", "api", "--results", "/results"]

FROM runtime AS harness
COPY --from=codex-source /usr/local/bin/codex /usr/local/bin/codex
COPY --from=codex-source /usr/local/share/codex-build /usr/local/share/codex-build
CMD ["python", "-m", "services.harness.server"]

FROM runtime AS manager
USER 0:0
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
RUN chown 0:0 /state
CMD ["python", "-m", "services.sandbox_manager.server"]

# В среду агента не копируются сервисы, чекеры, конфигурация или credentials.
FROM python-base AS sandbox
COPY --from=codex-source /usr/local/bin/codex /usr/local/bin/codex
COPY --from=codex-source /usr/local/share/codex-build /usr/local/share/codex-build
USER 1000:1000
CMD ["/usr/local/bin/codex", "--version"]
